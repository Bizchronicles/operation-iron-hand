
<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<meta name="theme-color" content="#101827">
<title>Operation Iron Hand</title>
<style>
:root{--bg:#0b1220;--panel:#141e30;--gold:#e8bd62;--text:#f3f5f8;--muted:#9ba9bc;--line:#29364a;--green:#52d6a0}
*{box-sizing:border-box}
body{margin:0;background:var(--bg);color:var(--text);font:15px Arial,sans-serif}
header{padding:20px;background:#101827;border-bottom:1px solid var(--line);position:sticky;top:0;z-index:5}
.brand{color:var(--gold);font-size:19px;font-weight:800;letter-spacing:1px}
header p{color:var(--muted);font-size:12px;margin:7px 0 0}
nav{display:flex;gap:8px;padding:12px;overflow-x:auto;background:#101827}
nav button{white-space:nowrap;background:var(--panel);color:var(--text);border:1px solid var(--line);padding:11px 14px;border-radius:9px}
nav button.active,button.primary{background:var(--gold);color:#171717;border-color:var(--gold);font-weight:bold}
main{padding:16px;max-width:1050px;margin:auto}
h1{font-size:25px;margin:10px 0}
h2{font-size:18px;margin-top:0}
.sub{color:var(--muted);line-height:1.6}
.grid{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:12px;margin:18px 0}
.card{background:var(--panel);border:1px solid var(--line);border-radius:14px;padding:16px;min-width:0}
.metric{font-size:25px;font-weight:bold;margin:12px 0 5px}
.gold{color:var(--gold)}.green{color:var(--green)}
label{display:block;color:var(--muted);font-size:13px;margin:12px 0 6px}
input,select,textarea{width:100%;padding:12px;background:#0c1524;color:var(--text);border:1px solid var(--line);border-radius:8px;font:inherit}
textarea{min-height:85px;resize:vertical}
button{cursor:pointer;font:inherit}
.action{padding:12px 15px;border:1px solid var(--line);background:#202c40;color:var(--text);border-radius:9px;margin-top:12px}
.full{width:100%}
.item{border-top:1px solid var(--line);padding:12px 0;overflow-wrap:anywhere}
.item small{display:block;color:var(--muted);margin-top:5px}
.tag{font-size:11px;color:var(--gold)}
.hidden{display:none!important}
.notice{padding:12px;border:1px solid #76623b;border-radius:10px;color:#f3d99b;line-height:1.5}
footer{text-align:center;color:var(--muted);font-size:12px;padding:30px}
@media(min-width:650px){.grid{grid-template-columns:repeat(3,minmax(0,1fr))}main{padding:25px}}
</style>
</head>
<body>
<header>
  <div class="brand">OPERATION IRON HAND</div>
  <p>AI-POWERED BUSINESS MANAGEMENT</p>
</header>
<nav id="nav">
  <button class="active" data-page="dashboard">Dashboard</button>
  <button data-page="sales">Sales</button>
  <button data-page="inventory">Inventory</button>
  <button data-page="suppliers">Suppliers</button>
  <button data-page="finance">Finance</button>
  <button data-page="chronicle">Chronicle</button>
  <button data-page="reports">Reports</button>
</nav>
<main>
<section id="dashboard" class="page">
  <h1>Owner Command Centre</h1>
  <p class="sub">Your business at a glance. Record activity and watch for important changes.</p>
  <div class="notice">Prototype mode: records are saved in this browser on this device. No real bank, supplier, or AI service is connected.</div>
  <div class="grid">
    <div class="card"><div class="sub">Recorded Sales</div><div class="metric gold" id="salesTotal">KSh 0</div><small class="sub">All recorded sales</small></div>
    <div class="card"><div class="sub">Expenses</div><div class="metric" id="expenseTotal">KSh 0</div><small class="sub">All recorded expenses</small></div>
    <div class="card"><div class="sub">Inventory Items</div><div class="metric" id="itemCount">0</div><small class="sub">Products tracked</small></div>
    <div class="card"><div class="sub">Low Stock Alerts</div><div class="metric gold" id="lowCount">0</div><small class="sub">Items needing attention</small></div>
    <div class="card"><div class="sub">Estimated Balance</div><div class="metric green" id="balance">KSh 0</div><small class="sub">Sales minus expenses</small></div>
    <div class="card"><div class="sub">Chronicle Events</div><div class="metric" id="eventCount">0</div><small class="sub">Business events recorded</small></div>
  </div>
  <div class="card"><h2>Priority Action Centre</h2><div id="alerts" class="sub">No alerts yet. Add inventory to begin monitoring.</div></div>
  <div class="card" style="margin-top:14px"><h2>Quick Actions</h2>
    <button class="action" onclick="showPage('sales')">+ Record a sale</button>
    <button class="action" onclick="showPage('inventory')">+ Add inventory</button>
    <button class="action" onclick="showPage('chronicle')">+ Log an event</button>
  </div>
</section>

<section id="sales" class="page hidden">
  <h1>Sales Register</h1><p class="sub">Record a completed sale in KSh.</p>
  <div class="card">
    <form id="saleForm">
      <label>Product or service</label><input name="name" required placeholder="e.g. Bread">
      <label>Amount (KSh)</label><input name="amount" type="number" min="1" step="0.01" required>
      <label>Customer (optional)</label><input name="customer" placeholder="Customer name">
      <button class="action primary full">Save Sale</button>
    </form>
  </div>
  <div class="card" style="margin-top:14px"><h2>Recent Sales</h2><div id="saleList"></div></div>
</section>

<section id="inventory" class="page hidden">
  <h1>Inventory Control</h1><p class="sub">Track stock and identify low-stock items.</p>
  <div class="card">
    <form id="stockForm">
      <label>Product name</label><input name="name" required placeholder="e.g. Sugar">
      <label>Quantity available</label><input name="qty" type="number" min="0" step="1" required>
      <label>Low-stock warning level</label><input name="min" type="number" min="0" step="1" value="5" required>
      <label>Unit cost (KSh, optional)</label><input name="cost" type="number" min="0" step="0.01" value="0">
      <button class="action primary full">Add Product</button>
    </form>
  </div>
  <div class="card" style="margin-top:14px"><h2>Stock List</h2><div id="stockList"></div></div>
</section>

<section id="suppliers" class="page hidden">
  <h1>Supplier Directory</h1><p class="sub">Keep supplier contacts in one place.</p>
  <div class="card">
    <form id="supplierForm">
      <label>Supplier or business name</label><input name="name" required>
      <label>Phone number</label><input name="phone" type="tel" placeholder="+254...">
      <label>Products supplied</label><input name="products" placeholder="e.g. Flour, sugar">
      <button class="action primary full">Save Supplier</button>
    </form>
  </div>
  <div class="card" style="margin-top:14px"><h2>Saved Suppliers</h2><div id="supplierList"></div></div>
</section>

<section id="finance" class="page hidden">
  <h1>Cash and Finance</h1><p class="sub">Record business expenses and review your basic cash position.</p>
  <div class="card">
    <form id="expenseForm">
      <label>Expense description</label><input name="name" required placeholder="e.g. Transport">
      <label>Amount (KSh)</label><input name="amount" type="number" min="0.01" step="0.01" required>
      <button class="action primary full">Record Expense</button>
    </form>
  </div>
  <div class="card" style="margin-top:14px"><h2>Expense History</h2><div id="expenseList"></div></div>
  <p class="sub">The estimated balance is sales minus expenses recorded in this prototype. It is not a bank balance or formal accounting statement.</p>
</section>

<section id="chronicle" class="page hidden">
  <h1>Business Chronicle</h1><p class="sub">Create a dated record of important business events.</p>
  <div class="card">
    <form id="eventForm">
      <label>Event title</label><input name="name" required placeholder="e.g. Received new stock">
      <label>Category</label><select name="category"><option>Operations</option><option>Customer</option><option>Staff</option><option>Finance</option><option>Supplier</option><option>Security</option></select>
      <label>Details</label><textarea name="details" required placeholder="What happened?"></textarea>
      <button class="action primary full">Save Event</button>
    </form>
  </div>
  <div class="card" style="margin-top:14px"><h2>Business Timeline</h2><div id="eventList"></div></div>
</section>

<section id="reports" class="page hidden">
  <h1>Reports and Data</h1><p class="sub">Export a copy of your prototype records.</p>
  <div class="card"><h2>Business Summary</h2><div id="reportSummary"></div>
  <button class="action primary full" onclick="exportData()">Export Business Data (JSON)</button>
  <button class="action full" onclick="exportCSV()">Export Chronicle (CSV)</button>
  </div>
  <div class="card" style="margin-top:14px"><h2>Security Centre</h2><p class="sub">This demo has no user login, server-side access controls, encrypted cloud backup, or verified audit trail. Do not enter passwords, bank credentials, or sensitive customer information. Add backend security before real business use.</p></div>
</section>
</main>
<footer>OPERATION IRON HAND · Prototype v0.1 · Owner-controlled business records</footer>
<script>
const KEY="operationIronHand.v1";
let db;
try{db=JSON.parse(localStorage.getItem(KEY))||{sales:[],expenses:[],stock:[],suppliers:[],events:[]}}
catch(e){db={sales:[],expenses:[],stock:[],suppliers:[],events:[]}}
function save(){localStorage.setItem(KEY,JSON.stringify(db));render()}
function money(n){return "KSh "+Number(n||0).toLocaleString("en-KE",{maximumFractionDigits:2})}
function safe(s){return String(s??"").replace(/[&<>"']/g,c=>({"&":"&amp;","<":"&lt;",">":"&gt;",'"':"&quot;","'":"&#39;"}[c]))}
function date(){return new Date().toLocaleString()}
function showPage(id){
 document.querySelectorAll(".page").forEach(p=>p.classList.toggle("hidden",p.id!==id));
 document.querySelectorAll("#nav button").forEach(b=>b.classList.toggle("active",b.dataset.page===id));
 window.scrollTo(0,0)
}
document.querySelectorAll("#nav button").forEach(b=>b.addEventListener("click",()=>showPage(b.dataset.page)));
function list(id,items,make){
 document.getElementById(id).innerHTML=items.length?items.slice().reverse().map(make).join(""):'<p class="sub">No records yet.</p>'
}
document.getElementById("saleForm").addEventListener("submit",e=>{
 e.preventDefault();let f=new FormData(e.target);
 db.sales.push({name:f.get("name"),amount:Number(f.get("amount")),customer:f.get("customer"),date:date()});
 db.events.push({name:"Sale recorded: "+f.get("name"),category:"Finance",details:"Sale value "+money(f.get("amount")),date:date()});
 e.target.reset();save()
});
document.getElementById("stockForm").addEventListener("submit",e=>{
 e.preventDefault();let f=new FormData(e.target);
 db.stock.push({id:Date.now(),name:f.get("name"),qty:Number(f.get("qty")),min:Number(f.get("min")),cost:Number(f.get("cost"))});
 db.events.push({name:"Inventory added: "+f.get("name"),category:"Operations",details:"Quantity "+f.get("qty"),date:date()});
 e.target.reset();e.target.elements.min.value=5;e.target.elements.cost.value=0;save()
});
document.getElementById("supplierForm").addEventListener("submit",e=>{
 e.preventDefault();let f=new FormData(e.target);
 db.suppliers.push({name:f.get("name"),phone:f.get("phone"),products:f.get("products"),date:date()});
 e.target.reset();save()
});
document.getElementById("expenseForm").addEventListener("submit",e=>{
 e.preventDefault();let f=new FormData(e.target);
 db.expenses.push({name:f.get("name"),amount:Number(f.get("amount")),date:date()});
 e.target.reset();save()
});
document.getElementById("eventForm").addEventListener("submit",e=>{
 e.preventDefault();let f=new FormData(e.target);
 db.events.push({name:f.get("name"),category:f.get("category"),details:f.get("details"),date:date()});
 e.target.reset();save()
});
function render(){
 const sales=db.sales.reduce((s,x)=>s+x.amount,0),expenses=db.expenses.reduce((s,x)=>s+x.amount,0);
 const low=db.stock.filter(x=>x.qty<=x.min);
 document.getElementById("salesTotal").textContent=money(sales);
 document.getElementById("expenseTotal").textContent=money(expenses);
 document.getElementById("itemCount").textContent=db.stock.length;
 document.getElementById("lowCount").textContent=low.length;
 document.getElementById("balance").textContent=money(sales-expenses);
 document.getElementById("eventCount").textContent=db.events.length;
 document.getElementById("alerts").innerHTML=low.length?low.map(x=>'<div class="item"><b>'+safe(x.name)+'</b> — only '+x.qty+' left (warning at '+x.min+')</div>').join(""):'<p class="green">No low-stock alerts. Keep your quantities updated.</p>';
 list("saleList",db.sales,x=>'<div class="item"><b>'+safe(x.name)+'</b> — '+money(x.amount)+'<small>'+safe(x.date)+(x.customer?' · Customer: '+safe(x.customer):'')+'</small></div>');
 list("stockList",db.stock,x=>'<div class="item"><b>'+safe(x.name)+'</b><small>Stock: '+x.qty+' · Warning level: '+x.min+' · Unit cost: '+money(x.cost)+'</small><button class="action" onclick="adjustStock('+x.id+',-1)">− 1</button> <button class="action" onclick="adjustStock('+x.id+',1)">+ 1</button> <button class="action" onclick="removeStock('+x.id+')">Remove</button>'+(x.qty<=x.min?' <span class="tag">LOW STOCK</span>':'')+'</div>');
 list("supplierList",db.suppliers,x=>'<div class="item"><b>'+safe(x.name)+'</b><small>'+safe(x.phone||"No phone added")+' · '+safe(x.products||"Products not specified")+'</small></div>');
 list("expenseList",db.expenses,x=>'<div class="item"><b>'+safe(x.name)+'</b> — '+money(x.amount)+'<small>'+safe(x.date)+'</small></div>');
 list("eventList",db.events,x=>'<div class="item"><b>'+safe(x.name)+'</b><span class="tag"> · '+safe(x.category)+'</span><small>'+safe(x.date)+'</small><div>'+safe(x.details)+'</div></div>');
 document.getElementById("reportSummary").innerHTML='<p>Recorded sales: <b>'+money(sales)+'</b></p><p>Recorded expenses: <b>'+money(expenses)+'</b></p><p>Estimated difference: <b>'+money(sales-expenses)+'</b></p><p>Stock products: <b>'+db.stock.length+'</b></p><p>Suppliers: <b>'+db.suppliers.length+'</b></p><p>Chronicle events: <b>'+db.events.length+'</b></p>'
}
function adjustStock(id,delta){let x=db.stock.find(x=>x.id===id);if(x){x.qty=Math.max(0,x.qty+delta);save()}}
function removeStock(id){if(confirm("Remove this product from the prototype inventory?")){db.stock=db.stock.filter(x=>x.id!==id);save()}}
function download(name,content,type){let a=document.createElement("a");a.href=URL.createObjectURL(new Blob([content],{type}));a.download=name;a.click();URL.revokeObjectURL(a.href)}
function exportData(){download("operation-iron-hand-data.json",JSON.stringify(db,null,2),"application/json")}
function exportCSV(){const q=s=>'"'+String(s??"").replace(/"/g,'""')+'"';download("operation-iron-hand-chronicle.csv",["Title,Category,Details,Date",...db.events.map(x=>[x.name,x.category,x.details,x.date].map(q).join(","))].join("\n"),"text/csv")}
render();
</script>
</body>
</html>
